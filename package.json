{
  "name": "hermes-harness",
  "version": "0.3.8",
  "description": "Multi-Terminal Harness mit Hermes-Integration, Projekt-Verwaltung und AI Agent Hub",
  "main": "dist-electron/main.js",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"npm:dev:vite\" \"npm:dev:main\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:main": "tsc -p electron/tsconfig.json --watch --preserveWatchOutput",
    "dev:electron": "wait-on http://localhost:5173/ dist-electron/main.js && cross-env NODE_ENV=development electron .",
    "build:main": "tsc -p electron/tsconfig.json",
    "build:renderer": "vite build",
    "prebuild": "node -e \"for (const f of ['src/pluginRegistry.js','src/pluginRegistry.js.map']) { try { require('fs').rmSync(f, { force: true }); } catch {} }\"",
    "build": "npm run build:main && npm run build:renderer",
    "start": "electron .",
    "test": "node --test \"tests/**/*.test.js\" \"tests/**/*.test.mjs\"",
    "typecheck": "tsc -p electron/tsconfig.json --noEmit && tsc -p tsconfig.json --noEmit",
    "dist": "npm run build && electron-builder --win",
    "icons": "node scripts/make-icons.mjs",
    "rebuild-native": "node scripts/patch-native.cjs && electron-rebuild -f -w better-sqlite3,@homebridge/node-pty-prebuilt-multiarch"
  },
  "build": {
    "appId": "com.hermesharness.app",
    "productName": "Cate",
    "artifactName": "Cate-Setup-${version}.${ext}",
    "files": [
      "dist-electron/**",
      "dist-renderer/**",
      "assets/**",
      "scripts/**",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Cate",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "asarUnpack": [
      "**/*.node"
    ]
  },
  "dependencies": {
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@homebridge/node-pty-prebuilt-multiarch": "^0.14.1",
    "@radix-ui/react-collapsible": "^1.1.21",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-label": "^2.1.16",
    "@radix-ui/react-popover": "^1.2.0",
    "@radix-ui/react-progress": "^1.1.17",
    "@radix-ui/react-scroll-area": "^1.3.0",
    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-separator": "^1.1.16",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-switch": "^1.3.8",
    "@radix-ui/react-tabs": "^1.1.22",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/xterm": "^5.5.0",
    "better-sqlite3": "^11.9.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.52.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "^2.1.7",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.6.1",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.29",
    "shadcn": "^4.21.3",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  }
}
